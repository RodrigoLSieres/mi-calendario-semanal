<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#111827">
<title>MI JORNADA NUEVA 24-09-202</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f3f4f6;color:#111827;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.app{max-width:520px;margin:auto;padding:14px 14px 80px}h1{font-size:24px;margin:8px 0 14px}.card{background:#fff;border-radius:18px;padding:17px;margin-bottom:12px;box-shadow:0 2px 10px rgba(0,0,0,.06)}.tabs{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #ddd;display:flex;z-index:5}.tabs button{border:0;background:none;padding:13px 8px;font-weight:700;color:#6b7280;flex:1}.tabs button.active{color:#111827}.status{text-align:center}.label{font-size:13px;color:#6b7280}.counter{font-size:43px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-1px;margin:4px 0}.state{margin-bottom:14px}.main{width:100%;border:0;border-radius:14px;padding:17px;font-size:18px;font-weight:800;background:#111827;color:#fff}.main.out{background:#16a34a}.vac{width:100%;margin-top:9px;border:0;border-radius:12px;padding:13px;font-weight:700;background:#fef3c7;color:#92400e}.grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.stat{background:#f9fafb;border-radius:13px;padding:12px}.stat strong{display:block;font-size:22px;margin-top:2px}.good{color:#15803d}.finish{background:#f9fafb;border-radius:13px;padding:13px;margin-top:10px}.finish b{font-size:20px}.small{font-size:12px;color:#6b7280;line-height:1.4}.progress{height:8px;background:#e5e7eb;border-radius:99px;overflow:hidden;margin-top:12px}.bar{height:100%;width:0;background:#111827}.calendarHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.calendarHead button{border:0;background:#f3f4f6;border-radius:10px;padding:8px 12px;font-size:18px}.monthTitle{font-weight:800;text-transform:capitalize}.cal{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}.weekday{text-align:center;font-size:11px;color:#6b7280;padding-bottom:3px}.cell{min-height:56px;border-radius:10px;background:#f9fafb;padding:5px;text-align:center;font-size:12px;cursor:pointer}.cell.empty{background:transparent}.cell.today{outline:2px solid #111827}.cell.vac{background:#fef3c7}.cell.holiday{background:#e5e7eb}.cell.remote{background:#dbeafe;color:#1e40af}.weekTotal{grid-column:1/-1;background:#eef2ff;border-radius:10px;padding:8px 10px;margin:2px 0 7px;text-align:right;font-size:12px;color:#3730a3}.weekTotal b{font-size:14px}.cell .mins{display:block;font-weight:700;margin-top:5px}.cell .extra{display:block;font-size:10px;color:#15803d}.legend{margin-top:12px}.timeField{width:100%;padding:12px;border:1px solid #d1d5db;border-radius:10px;font-size:16px;margin-top:8px;background:#fff}.clockOverlay{position:fixed;inset:0;background:rgba(0,0,0,.42);display:none;align-items:flex-end;justify-content:center;z-index:20}.clockBox{width:min(520px,100%);background:#fff;border-radius:24px 24px 0 0;padding:18px 18px 24px}.clockTitle{text-align:center;font-weight:800;font-size:17px}.clockTime{text-align:center;font-size:38px;font-weight:800;margin:3px 0 8px;font-variant-numeric:tabular-nums}.clockHint{text-align:center;color:#6b7280;font-size:13px;margin-bottom:8px}.clockFace{width:280px;height:280px;border-radius:50%;background:#f3f4f6;position:relative;margin:10px auto 15px;touch-action:none}.clockCenter{position:absolute;width:10px;height:10px;border-radius:50%;background:#111827;left:50%;top:50%;transform:translate(-50%,-50%);z-index:2}.clockHand{position:absolute;width:3px;height:104px;background:#111827;left:calc(50% - 1.5px);top:36px;transform-origin:50% 104px;z-index:1}.clockNumber{position:absolute;left:50%;top:50%;width:34px;height:34px;line-height:34px;text-align:center;border-radius:50%;font-size:15px;transform:translate(-50%,-50%);font-weight:600}.clockNumber.sel{background:#111827;color:#fff}.clockActions{display:flex;gap:8px}.clockActions button{flex:1;border:0;border-radius:12px;padding:13px;font-weight:700;background:#e5e7eb}.clockActions .ok{background:#111827;color:#fff}
</style>
</head>
<body>
<div class="app">
<section id="home"><h1>⏱️ Mi jornada</h1><div class="card status"><div class="label" id="dateLabel"></div><div class="counter" id="counter">00:00:00</div><div class="state" id="state">No has fichado</div><button class="main" id="mainBtn">ENTRAR</button><button class="vac" id="manualEntryToday" style="background:#e5e7eb;color:#111827">🕐 INTRODUCIR ENTRADA DE HOY</button><button class="vac" id="remoteBtn" style="background:#dbeafe;color:#1e40af">🏠 TELETRABAJO HOY (7:30)</button><button class="vac" id="vacBtn">🏖️ VACACIONES HOY (7:30)</button></div>
<div class="card"><div class="grid"><div class="stat"><span class="label">Hoy trabajado</span><strong id="today">0:00</strong></div><div class="stat"><span class="label">Entrada / salida</span><strong id="todayTimes">— / —</strong></div><div class="stat"><span class="label">Hoy de más</span><strong id="dayExtra">0 min</strong></div><div class="stat"><span class="label">Semana</span><strong id="week">0:00</strong></div><div class="stat"><span class="label">Semana de más</span><strong id="weekExtra">0 min</strong></div><div class="stat"><span class="label">Mes</span><strong id="month">0:00</strong></div><div class="stat"><span class="label">Objetivo semanal</span><strong>37:30</strong></div><div class="stat"><span class="label">Pendiente semana</span><strong id="weekRemaining">37:30</strong></div></div><div class="progress"><div class="bar" id="bar"></div></div><div class="finish"><div class="label">Si sigues trabajando, deberías terminar a las</div><b id="finish">—</b><div class="small" id="finishInfo"></div><div class="small" id="weekPlan" style="margin-top:7px"></div></div></div>
<div class="card"><div class="small"><b>Cómo funciona:</b> pulsa ENTRAR al comenzar y SALIR al terminar. El contador continúa aunque cierres la página. Las vacaciones, el teletrabajo y los festivos suman 7 h 30 min.</div></div></section>
<section id="calendar" style="display:none"><h1>📅 Calendario</h1><div class="card"><div class="calendarHead"><button id="prev">‹</button><div class="monthTitle" id="monthTitle"></div><button id="next">›</button></div><button id="addHoliday" style="width:100%;border:0;border-radius:12px;padding:12px;background:#f3f4f6;font-weight:700;margin-bottom:10px">🎉 Marcar festivo</button><div class="cal" id="cal"></div><div class="small legend">Pulsa un día para editarlo, marcar vacaciones o consultar sus horas.</div><div id="editDay" style="display:none;margin-top:12px;padding-top:12px;border-top:1px solid #eee"><div class="label">Editar día seleccionado</div><div id="editDateLabel" style="font-weight:700;margin:4px 0"></div><button class="timeField" id="entryField">Entrada: —</button><button class="timeField" id="exitField">Salida: —</button><div class="small" id="editDuration" style="margin-top:8px"></div><button id="saveDay" style="width:100%;margin-top:8px;border:0;border-radius:12px;padding:13px;font-weight:700">Guardar jornada</button><button id="editRemote" style="width:100%;margin-top:7px;border:0;border-radius:12px;padding:11px;background:#dbeafe;color:#1e40af;font-weight:700">Marcar / quitar teletrabajo</button><button id="editVacation" style="width:100%;margin-top:7px;border:0;border-radius:12px;padding:11px;background:#fef3c7;color:#92400e;font-weight:700">Marcar / quitar vacaciones</button></div></div></section>
</div>
<nav class="tabs"><button id="tabHome" class="active">⏱️ Hoy</button><button id="tabCal">📅 Calendario</button></nav>
<div class="clockOverlay" id="clockOverlay"><div class="clockBox"><div class="clockTitle" id="clockTitle">Selecciona la hora</div><div class="clockTime" id="clockTime">08:00</div><div class="clockHint" id="clockHint">Primero elige la hora</div><div class="clockFace" id="clockFace"><div class="clockHand" id="clockHand"></div><div class="clockCenter"></div></div><div class="clockActions"><button id="clockCancel">Cancelar</button><button class="ok" id="clockOk">Aceptar</button></div></div></div>
<script>
const KEY="jornada_v2",TARGET=27000000,WEEK_TARGET=135000000,$=id=>document.getElementById(id),pad=n=>String(n).padStart(2,"0");
let storage=null,data={days:{},active:null};if(location.origin!=="null"){try{storage=window.localStorage;data=JSON.parse(storage.getItem(KEY))||data}catch{storage=null}}data.days||={};data.active??=null;let calendarDate=new Date(),selectedDate=null,editEntry=null,editExit=null,clockMode=null,clockStage="hour",clockValue=480;
function iso(d){return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate())}function today(){return iso(new Date())}function save(){if(storage){try{storage.setItem(KEY,JSON.stringify(data))}catch{storage=null}}}function fmt(ms,seconds=false){let s=Math.floor(Math.max(0,ms)/1000),h=Math.floor(s/3600),m=Math.floor(s%3600/60),x=s%60;return seconds?`${pad(h)}:${pad(m)}:${pad(x)}`:`${h}:${pad(m)}`}function fmtMin(ms){return Math.floor(Math.max(0,ms)/60000)}
function dayMs(k){let d=data.days[k];if(!d)return 0;if(d.vacation||d.holiday||d.remote)return TARGET;return (d.total||0)+(data.active&&k===today()?Date.now()-data.active:0)}
function monday(k){let d=new Date(k+"T12:00:00"),n=d.getDay();d.setDate(d.getDate()+(n===0?-6:1-n));return iso(d)}function weekTotal(ref=today()){let mon=monday(ref);return Object.keys(data.days).reduce((s,k)=>s+(monday(k)===mon?dayMs(k):0),0)}function monthTotal(ref=today()){let p=ref.slice(0,7);return Object.keys(data.days).reduce((s,k)=>s+(k.startsWith(p)?dayMs(k):0),0)}
function startStop(){let k=today();data.days[k]||={total:0};if(data.days[k].vacation||data.days[k].holiday||data.days[k].remote){alert("Hoy está marcado como vacaciones, festivo o teletrabajo.");return}if(data.active){data.days[k].total=(data.days[k].total||0)+(Date.now()-data.active);let n=new Date();data.days[k].exit=n.getHours()*60+n.getMinutes();data.active=null}else{let n=new Date();data.active=Date.now();data.days[k].entry=n.getHours()*60+n.getMinutes();data.days[k].exit=null;}save();render()}
function toggleVacationDate(k){if(k===today()&&data.active){alert("Primero pulsa SALIR.");return}data.days[k]||={total:0};let v=!data.days[k].vacation;data.days[k]={total:0,vacation:v,holiday:false,remote:false,entry:null,exit:null};save();render();renderCalendar()}
function toggleRemoteDate(k){if(k===today()&&data.active){alert("Primero pulsa SALIR.");return}data.days[k]||={total:0};let r=!data.days[k].remote;data.days[k]={total:0,remote:r,vacation:false,holiday:false,entry:null,exit:null};save();render();renderCalendar();if(selectedDate===k)editDate(k)}
function render(){let now=new Date(),k=today(),t=dayMs(k),w=weekTotal(),mo=monthTotal(),rec=data.days[k];$("dateLabel").textContent=now.toLocaleDateString("es-ES",{weekday:"long",day:"numeric",month:"long"});$("counter").textContent=fmt(t,true);$("state").textContent=rec?.vacation?"🏖️ Vacaciones":rec?.holiday?"🎉 Festivo":rec?.remote?"🏠 Teletrabajo":data.active?"🟢 Jornada en curso":rec?.entry!=null?"🕐 Jornada manual registrada":"⚪ No has fichado";$("mainBtn").textContent=data.active?"SALIR":"ENTRAR";$("mainBtn").classList.toggle("out",!!data.active);$("today").textContent=fmt(t);let liveEntry=data.active?new Date(data.active).getHours()*60+new Date(data.active).getMinutes():null;$("todayTimes").textContent=minsToLabel(rec?.entry??liveEntry)+" / "+minsToLabel(rec?.exit);$("week").textContent=fmt(w);$("month").textContent=fmt(mo);let de=Math.max(0,t-TARGET),we=Math.max(0,w-WEEK_TARGET);$("dayExtra").textContent=de?fmt(de):"0:00";$("weekExtra").textContent=we?fmt(we):"0:00";$("weekRemaining").textContent=fmt(Math.max(0,WEEK_TARGET-w));$("bar").style.width=Math.min(100,w/WEEK_TARGET*100)+"%";let rd=Math.max(0,TARGET-t),rw=Math.max(0,WEEK_TARGET-w);if(rec?.vacation||rec?.holiday||rec?.remote){$("finish").textContent="No necesario";$("finishInfo").textContent="Hoy cuenta como 7 h 30 min."}else if(data.active){$("finish").textContent=new Date(Date.now()+rd).toLocaleTimeString("es-ES",{hour:"2-digit",minute:"2-digit"});$("finishInfo").textContent=`Hoy faltan ${fmt(rd)} para llegar a 7:30.`}else{$("finish").textContent="—";$("finishInfo").textContent=`Hoy te faltan ${fmt(rd)}; de la semana ${fmt(rw)}.`}let base=new Date(k+"T12:00:00"),dow=base.getDay(),available=0,credited=0;for(let i=0;i<=Math.max(0,5-Math.max(1,dow));i++){let d=new Date(base);d.setDate(base.getDate()+i);let wd=d.getDay();if(wd<1||wd>5)continue;let dk=iso(d),r=data.days[dk];if(dk<k)continue;if(r?.vacation||r?.holiday||r?.remote)credited+=TARGET;else available++}let realPending=Math.max(0,rw-credited),perDay=available?realPending/available:0;$("weekPlan").innerHTML=realPending?`<b>Plan semanal:</b> ${fmt(realPending)} pendientes entre ${available} día${available===1?"":"s"} laborable${available===1?"":"s"}: aproximadamente <b>${fmt(perDay)} por día</b>.`:`<b>Semana completada o cubierta con vacaciones, teletrabajo y festivos.</b>`}
function minsToLabel(v){return v==null?"—":pad(Math.floor(v/60)%24)+":"+pad(v%60)}function updateEditFields(){$("entryField").textContent="Entrada: "+minsToLabel(editEntry);$("exitField").textContent="Salida: "+minsToLabel(editExit);if(editEntry!=null&&editExit!=null){let d=editExit-editEntry;if(d<0)d+=1440;$("editDuration").textContent="Tiempo trabajado: "+fmt(d*60000)}else $("editDuration").textContent=""}
function editDate(k){selectedDate=k;let d=data.days[k]||{};$("editDay").style.display="block";$("editDateLabel").textContent=new Date(k+"T12:00:00").toLocaleDateString("es-ES",{weekday:"long",day:"numeric",month:"long",year:"numeric"});editEntry=d.entry??null;editExit=d.exit??null;updateEditFields()}
function saveEditedDay(){if(!selectedDate||editEntry==null||editExit==null){alert("Selecciona entrada y salida.");return}if(selectedDate===today()&&data.active){alert("Primero pulsa SALIR.");return}let d=editExit-editEntry;if(d<0)d+=1440;data.days[selectedDate]={total:d*60000,entry:editEntry,exit:editExit,vacation:false,holiday:false,remote:false};save();render();renderCalendar();editDate(selectedDate)}
function openClock(mode,initial){clockMode=mode;clockStage="hour";clockValue=initial??480;$("clockOverlay").style.display="flex";$("clockTitle").textContent=mode==="entry"?"Hora de entrada":"Hora de salida";$("clockHint").textContent="Elige una hora (00–23)";drawClock()}function closeClock(){$("clockOverlay").style.display="none";clockMode=null}function chooseClockValue(v){if(clockStage==="hour"){clockValue=v*60+clockValue%60;clockStage="minute";$("clockHint").textContent="Ahora elige los minutos";drawClock();return}clockValue=Math.floor(clockValue/60)*60+v;drawClock()}
function drawClock(){let face=$("clockFace"),hour=clockStage==="hour",sel=hour?Math.floor(clockValue/60)%24:clockValue%60,vals=hour?Array.from({length:24},(_,i)=>i):Array.from({length:12},(_,i)=>i*5);face.querySelectorAll(".clockNumber").forEach(x=>x.remove());vals.forEach(v=>{let a=(hour?v%12:v/5)*30*Math.PI/180,r=hour?((v>0&&v<=12)?106:70):106,n=document.createElement("div");n.className="clockNumber"+(v===sel?" sel":"");n.textContent=pad(v);n.style.left=140+Math.sin(a)*r+"px";n.style.top=140-Math.cos(a)*r+"px";n.onclick=()=>chooseClockValue(v);face.appendChild(n)});$("clockTime").textContent=minsToLabel(clockValue);$("clockHand").style.transform=`rotate(${(hour?(sel%12):sel/5)*30}deg)`}
function clockDone(){if(clockStage==="hour"){clockStage="minute";$("clockHint").textContent="Ahora elige los minutos";drawClock();return}if(clockMode==="entry")editEntry=clockValue;else editExit=clockValue;updateEditFields();closeClock()}
function addHoliday(){let k=prompt("Fecha del festivo (AAAA-MM-DD):",selectedDate||today());if(!k||!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(k))return;if(k===today()&&data.active){alert("Primero pulsa SALIR.");return}data.days[k]||={total:0};let h=!data.days[k].holiday;data.days[k]={total:0,holiday:h,vacation:false,remote:false,entry:null,exit:null};save();render();renderCalendar();editDate(k)}
function renderCalendar(){let y=calendarDate.getFullYear(),m=calendarDate.getMonth();$("monthTitle").textContent=new Date(y,m,1).toLocaleDateString("es-ES",{month:"long",year:"numeric"});let last=new Date(y,m+1,0),firstWd=new Date(y,m,1).getDay(),start=(firstWd>=1&&firstWd<=5)?firstWd-1:0;let out=["L","M","X","J","V"].map(x=>`<div class="weekday">${x}</div>`).join("");for(let i=0;i<start;i++)out+='<div class="cell empty"></div>';let weekKeys=[];function addWeekTotal(){if(!weekKeys.length)return;let total=weekKeys.reduce((sum,key)=>sum+dayMs(key),0);out+=`<div class="weekTotal">Total semanal: <b>${fmt(total)}</b> · Pendiente: <b>${fmt(Math.max(0,WEEK_TARGET-total))}</b></div>`;weekKeys=[]}for(let d=1;d<=last.getDate();d++){let date=new Date(y,m,d),wd=date.getDay();if(wd===0||wd===6)continue;let k=iso(date),ms=dayMs(k),r=data.days[k],extra=Math.max(0,ms-TARGET),cls=["cell",k===today()?"today":"",r?.vacation?"vac":"",r?.holiday?"holiday":"",r?.remote?"remote":""].join(" ");out+=`<div class="${cls}" data-date="${k}"><b>${d}</b>${r?.vacation?'<span class="mins">🏖️ 7:30</span>':r?.holiday?'<span class="mins">🎉 7:30</span>':r?.remote?'<span class="mins">🏠 7:30</span>':ms?`<span class="mins">${fmt(ms)}</span>${extra?`<span class="extra">+${fmtMin(extra)}m</span>`:""}`:""}</div>`;weekKeys.push(k);if(wd===5)addWeekTotal()}addWeekTotal();$("cal").innerHTML=out;document.querySelectorAll("#cal .cell[data-date]").forEach(c=>c.onclick=()=>editDate(c.dataset.date))}
function show(tab){$("home").style.display=tab==="home"?"block":"none";$("calendar").style.display=tab==="calendar"?"block":"none";$("tabHome").classList.toggle("active",tab==="home");$("tabCal").classList.toggle("active",tab==="calendar");if(tab==="calendar")renderCalendar()}
$("mainBtn").onclick=startStop;$("vacBtn").onclick=()=>toggleVacationDate(today());$("remoteBtn").onclick=()=>toggleRemoteDate(today());$("manualEntryToday").onclick=()=>{if(data.active){alert("Ya hay una jornada en curso.");return}editDate(today());openClock("entry",editEntry)};$("saveDay").onclick=saveEditedDay;$("entryField").onclick=()=>openClock("entry",editEntry);$("exitField").onclick=()=>openClock("exit",editExit);$("clockCancel").onclick=closeClock;$("clockOk").onclick=clockDone;$("editVacation").onclick=()=>selectedDate&&toggleVacationDate(selectedDate);$("editRemote").onclick=()=>selectedDate&&toggleRemoteDate(selectedDate);$("addHoliday").onclick=addHoliday;$("tabHome").onclick=()=>show("home");$("tabCal").onclick=()=>show("calendar");$("prev").onclick=()=>{calendarDate.setMonth(calendarDate.getMonth()-1);renderCalendar()};$("next").onclick=()=>{calendarDate.setMonth(calendarDate.getMonth()+1);renderCalendar()};setInterval(()=>{render();if($("calendar").style.display!=="none")renderCalendar()},1000);render();
</script>
</body>
</html>
